do
    local LIMIT = 40
    local FARM = { on = false }
    local collected, floating, lastCont = 0, false, nil
    local done = {}

    local info = make("Frame", {
        LayoutOrder = 2,
        Size = UDim2.new(1, -6, 0, 34),
        BackgroundColor3 = ROW,
        BorderSizePixel = 0,
    }, farmPage)
    round(info, 10)
    local countLabel = make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -20, 1, 0),
        BackgroundTransparency = 1,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "🪙 0 / " .. LIMIT,
    }, info)

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local function release()
        floating = false
        local _, hrp = myParts()
        if hrp then hrp.Anchored = false end
    end

    local function float()
        local c, hrp = myParts()
        if not (c and hrp) then return end
        floating = true
        c:PivotTo(hrp.CFrame + Vector3.new(0, 120, 0))
        hrp.Anchored = true
    end

    local function coinPart(o)
        if o:IsA("BasePart") then return o end
        return o:FindFirstChildWhichIsA("BasePart", true)
    end

    local function nextCoin(cont, hrp)
        local best, bd
        for _, o in ipairs(cont:GetChildren()) do
            local p = coinPart(o)
            if p and (done[p] or 0) < 99 then
                local d = (p.Position - hrp.Position).Magnitude
                if not bd or d < bd then
                    best, bd = p, d
                end
            end
        end
        return best
    end

    local function step()
        local c, hrp, hum = myParts()
        if not (c and hrp and hum and hum.Health > 0) then return end

        local cont = workspace:FindFirstChild("CoinContainer", true)
        if cont ~= lastCont then
            lastCont = cont
            collected = 0
            done = {}
            release()
        end
        if floating and not hrp.Anchored then floating = false end

        countLabel.Text = "🪙 " .. collected .. " / " .. LIMIT .. (floating and "  ⬆" or "")

        if collected >= LIMIT then
            if not floating then float() end
            return
        end
        if not cont then return end

        local coin = nextCoin(cont, hrp)
        if not coin then return end

        c:PivotTo(CFrame.new(coin.Position))
        if firetouchinterest then
            pcall(firetouchinterest, hrp, coin, 0)
            pcall(firetouchinterest, hrp, coin, 1)
        end
        task.wait(0.2)

        done[coin] = (done[coin] or 0) + 1
        if not coin.Parent or coin.Transparency >= 0.99 then
            collected += 1
            done[coin] = 99
        elseif done[coin] >= 3 then
            done[coin] = 99
        end
    end

    makeToggle(farmPage, 1, "cfCoin", "cfCoinD", function(v)
        FARM.on = v
        if not v then release() end
    end)

    task.spawn(function()
        while gui.Parent do
            task.wait(0.25)
            if FARM.on then
                pcall(step)
            end
        end
    end)
end

