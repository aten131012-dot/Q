local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

local function decorateButton(button)
    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = BTN_HOVER
    end)
    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = BTN
    end)
    button.InputBegan:Connect(function(i)
        if isPress(i) then button.BackgroundColor3 = BTN_HOVER end
    end)
    button.InputEnded:Connect(function(i)
        if isPress(i) then button.BackgroundColor3 = BTN end
    end)
end

local function cuteButton(props, parent)
    props.BackgroundColor3 = BTN
    props.TextColor3 = WHITE
    props.AutoButtonColor = false
    props.BorderSizePixel = 0
    props.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    props.TextStrokeTransparency = 0.45
    props.Font = props.Font or Enum.Font.GothamBold
    local b = make("TextButton", props, parent)
    decorateButton(b)
    return b
end

