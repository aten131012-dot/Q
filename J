        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if not (char and head) then
            clearPlayer(plr)
            return
        end
        local e = pEsp[plr]
        if e and (e.char ~= char or not e.hl.Parent or not e.gui.Parent) then
            clearPlayer(plr)
            e = nil
        end
        if not e then
            local hl = makeHL(char, COL[role], 0.55)
            local g, l = makeTag(head, head, 170, 40, Vector3.new(0, 2.6, 0))
            e = { char = char, hl = hl, gui = g, label = l }
            pEsp[plr] = e
        end
        local c = COL[role]
        e.hl.FillColor = c
        e.hl.OutlineColor = c
        e.label.TextColor3 = c
        e.label.Text = plr.DisplayName .. "\n" .. ROLE_TXT[lang][role] .. " [" .. distTo(head.Position) .. "m]"
