local function makeDraggable(handle, target, flag)
    local dragging, startIn, startPos = false, nil, nil

    handle.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging = true
            startIn = input.Position
            startPos = target.Position
            if flag then flag.moved = false end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local d = input.Position - startIn
            if flag and (math.abs(d.X) > 5 or math.abs(d.Y) > 5) then
                flag.moved = true
            end
            if not flag or flag.moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if dragging and isPress(input) then
            dragging = false
            if flag then
                task.delay(0.05, function() flag.moved = false end)
            end
        end
    end)
end

