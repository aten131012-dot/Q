            if hum then hum.JumpPower = JUMP_BASE end
        end
    end)
    makeToggle(playersPage, 4, "pFly", "pFlyD", function(v)
        P.fly = v
        if not v then stopFly() end
    end)
    makeToggle(playersPage, 5, "pTp", "pTpD", function(v)
        P.tp = v
        if v then
            giveTool()
        elseif tpTool then
            tpTool:Destroy()
            tpTool = nil
        end
    end)
    makeToggle(playersPage, 6, "pAnti", "pAntiD", function(v) P.anti = v end)
