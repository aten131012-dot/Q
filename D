        for _ = 1, 40 do
            ev = ev or findRemote({ PlayerDataChanged = true }, "RemoteEvent")
            fn = fn or findRemote({ GetCurrentPlayerData = true, GetPlayerData = true }, "RemoteFunction")
            if ev and fn then break end
            task.wait(0.5)
        end
